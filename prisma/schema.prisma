// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ArticleQualityStatus {
  OK
  NEEDS_REVIEW
  FAILED
  NOT_A_CRASH // In the database since 20261019130000_add_not_a_crash but never written: non-crashes are FAILED with a note
}

enum ImageStatus {
  NONE
  OK
  FAILED
}

model Incident {
  id         String   @id @default(cuid())
  slug       String   @unique
  headline   String
  summary    String?
  city       String?
  state      String?
  country    String?
  occurredAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  dedupeKey  String   @unique

  // SEO article fields (generated by OpenAI at ingestion time)
  articleBody    String?  // Full 400-700 word SEO article
  seoTitle       String?  // SEO-optimized title (50-60 chars)
  seoDescription String?  // Meta description (150-160 chars)

  // Article quality tracking
  articleQualityStatus ArticleQualityStatus? @default(OK)
  articleQualityNotes  String?               // Validation warnings or error details
  articleAttempts      Int?                  @default(0) // Generation attempts; the cron gives up after 2
  articleAttemptedAt   DateTime?             // Last attempt, counted against ARTICLE_DAILY_LIMIT
  articleTextTriedAt   DateTime?             // The publisher's article text could not be fetched; wait for a second publisher

  // Structured facts extracted from news sources (JSON)
  extractedFacts Json?    // Companies, vehicles, people, agencies, etc.

  // Generated illustration (stored on Vercel Blob)
  imageUrl         String?
  imageAlt         String?
  imageStatus      ImageStatus @default(NONE)
  imageModel       String?
  imageCostUsd     Decimal?    @db.Decimal(10, 6)
  imageGeneratedAt DateTime?
  imageAttempts    Int         @default(0)

  sources IncidentSource[]

  @@index([occurredAt])
  @@index([city, state])
  @@index([createdAt])
  @@index([imageStatus, createdAt])
}

model IncidentSource {
  id          String   @id @default(cuid())
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  incidentId  String

  sourceType  String   // "google_news"
  url         String
  title       String
  publisher   String?
  publisherDomain String? // Host of the publisher's site, from the feed's <source url>
  snippet     String?
  publishedAt DateTime

  @@index([incidentId])
  @@index([publishedAt])
}
